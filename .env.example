# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/KingsCutAddis

# Auth
SECRET_KEY=generate-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seed admin (used by scripts/seed_admin.py)
ADMIN_EMAIL=admin@kingscutaddis.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=Owner
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=0911000000

# Telegram (from @BotFather)
# 1. Message @BotFather → /newbot → copy the token here
# 2. /setmenubutton or Mini App URL (HTTPS) for TELEGRAM_MINI_APP_URL
TELEGRAM_BOT_TOKEN= 
TELEGRAM_MINI_APP_URL=

# Local folder for promotion photos/videos (same path on your server later)
UPLOAD_DIR=uploads

# SMS provider (configure in Phase 9)
SMS_API_KEY=
SMS_SENDER_ID=
